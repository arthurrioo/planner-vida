# Planner Vida local environment
# Copy this file to .env.local and fill values from the approved environment store.
# Do not commit .env.local or real credentials.

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth values used by the browser and server session client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only privileged key for infrastructure paths only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional operational metadata for future audit/log correlation.
APP_VERSION=local

# Vercel sets this automatically in hosted environments.
# Expected preview value: preview
# Expected production value: production
VERCEL_ENV=
