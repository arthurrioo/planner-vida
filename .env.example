# Planner Vida local environment
# Copy this file to .env.local and fill values from the approved environment store.
# Do not commit .env.local or real credentials.

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase values are documented for Milestone 02+ only.
# They are intentionally unused by Milestone 01 bootstrap code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional operational metadata for future audit/log correlation.
APP_VERSION=local
